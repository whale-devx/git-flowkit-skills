{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git FlowKit configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "[a-z][a-z0-9-]*",
            "maxLength": 40
          }
        },
        "max_length": {
          "type": "integer",
          "minimum": 10,
          "maximum": 200
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "[a-z][a-z0-9-]*",
            "maxLength": 40
          }
        },
        "max_subject_length": {
          "type": "integer",
          "minimum": 20,
          "maximum": 256
        },
        "require_scope": {
          "type": "boolean"
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "pr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "merge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_approvals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "release-please",
            "semantic-release",
            "changesets",
            "python-semantic-release",
            "release-plz",
            "goreleaser",
            "jreleaser"
          ]
        },
        "tag_prefix": {
          "type": "string",
          "maxLength": 80,
          "pattern": "[A-Za-z0-9._/-]*"
        },
        "pre1_breaking": {
          "type": "string",
          "enum": [
            "major",
            "minor"
          ]
        },
        "pre1_features": {
          "type": "string",
          "enum": [
            "minor",
            "patch"
          ]
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "none",
              "patch",
              "minor",
              "major"
            ]
          }
        }
      }
    }
  },
  "required": [
    "version"
  ]
}
