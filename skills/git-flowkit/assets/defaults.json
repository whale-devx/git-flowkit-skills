{
  "version": 1,
  "branch": {
    "pattern": "{type}/{ticket}{slug}",
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert",
      "hotfix",
      "release"
    ],
    "max_length": 100
  },
  "commit": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "max_subject_length": 100,
    "require_scope": false
  },
  "templates": {},
  "merge": {
    "required_approvals": 1
  },
  "release": {
    "engine": "auto",
    "tag_prefix": "v",
    "pre1_breaking": "major",
    "pre1_features": "minor",
    "rules": {
      "feat": "minor",
      "fix": "patch",
      "perf": "patch"
    }
  }
}
